# Copy to .env, or set the variables in the scheduler. Values are taken literally: no shell expansion.
# DATABASE_URL is mandatory once this file exists: make supplies and starts the compose database only when there is
# neither a .env nor a DATABASE_URL in the environment. This value is that database; `make db` starts it by hand.
# To move that database, add DB_PORT=<port> below and change this URL's port to match.
DATABASE_URL=postgresql://sec:sec@localhost:25432/sec_filings
# EDGAR fair-access rules require a declared User-Agent with a contact address.
SEC_USER_AGENT="sec-filings take-home abe.alcarazm@gmail.com"
# Requests per second to EDGAR (the published maximum is 10; stay below it).
SEC_RATE_LIMIT_PER_SEC=5
# Where the list of companies lives (one ticker per row, header "ticker").
COMPANIES_FILE=companies.csv
# Per-company facts EDGAR does not give or gives wrong (predecessor CIKs, missing fiscal year ends).
OVERRIDES_FILE=overrides.toml
